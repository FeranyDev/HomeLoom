{
  "name": "homeloom-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --outDir ../backend/internal/webui/dist --emptyOutDir",
