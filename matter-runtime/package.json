{
  "name": "@homeloom/matter-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "HomeLoom Matter sidecar and Unix socket IPC contract",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:sea": "node scripts/build-sea.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@matter/general": "0.17.7",
    "@matter/main": "0.17.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  }
}
