{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeloom.local/schemas/mqtt-protocol-v1.json",
  "title": "HomeLoom MQTT Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/device" },
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/availability" },
    { "$ref": "#/$defs/command" }
  ],
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" },
    "value": {
      "oneOf": [
        { "type": "object", "required": ["type", "bool"], "properties": { "type": { "const": "bool" }, "bool": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "int"], "properties": { "type": { "const": "int" }, "int": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "number"], "properties": { "type": { "const": "number" }, "number": { "type": "number" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "string"], "properties": { "type": { "enum": ["string", "enum"] }, "string": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "propertyDefinition": {
      "type": "object",
      "required": ["id", "name", "type", "readable", "writable", "notifiable"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["bool", "int", "number", "string", "enum"] }, "unit": { "type": "string" },
        "readable": { "type": "boolean" }, "writable": { "type": "boolean" }, "notifiable": { "type": "boolean" },
        "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" },
        "enum": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "staleAfterSeconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "property": {
      "type": "object", "required": ["definition", "value"],
      "properties": { "definition": { "$ref": "#/$defs/propertyDefinition" }, "value": { "$ref": "#/$defs/value" } },
      "additionalProperties": false
    },
    "commandDefinition": {
      "type": "object", "required": ["id", "name", "idempotent"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 }, "idempotent": { "type": "boolean" },
        "parameters": { "type": "array", "items": { "type": "object", "required": ["id", "name", "type", "required"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string" }, "type": { "enum": ["bool", "int", "number", "string", "enum"] }, "required": { "type": "boolean" } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object", "required": ["id", "type", "properties"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "type": { "type": "string" }, "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }, "commands": { "type": "array", "items": { "$ref": "#/$defs/commandDefinition" } } },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object", "required": ["id", "name", "type", "capabilities"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string" }, "type": { "type": "string" }, "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } } },
      "additionalProperties": false
    },
    "device": {
      "title": "Discovery payload", "type": "object",
      "required": ["schemaVersion", "id", "name", "type", "endpoints", "lastUpdateAt"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/stableId" }, "providerId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 },
        "availability": { "enum": ["online", "offline", "unknown"] }, "online": { "type": "boolean" },
        "sequence": { "type": "integer", "minimum": 0 }, "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
        "lastUpdateAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "state": {
      "title": "State payload", "type": "object", "required": ["schemaVersion", "value", "sequence", "observedAt"],
      "properties": { "schemaVersion": { "const": 1 }, "value": { "$ref": "#/$defs/value" }, "sequence": { "type": "integer", "minimum": 1 }, "observedAt": { "type": "string", "format": "date-time" }, "correlationId": { "type": "string" } },
      "additionalProperties": false
    },
    "availability": {
      "title": "Availability payload", "type": "object", "required": ["schemaVersion", "availability", "sequence", "observedAt"],
      "properties": { "schemaVersion": { "const": 1 }, "availability": { "enum": ["online", "offline", "unknown"] }, "sequence": { "type": "integer", "minimum": 1 }, "observedAt": { "type": "string", "format": "date-time" } },
      "additionalProperties": false
    },
    "command": {
      "title": "Command payload", "type": "object", "required": ["schemaVersion", "kind", "correlationId", "createdAt"],
      "properties": { "schemaVersion": { "const": 1 }, "kind": { "enum": ["property", "action"] }, "correlationId": { "type": "string", "minLength": 1 }, "idempotencyKey": { "type": "string" }, "value": { "$ref": "#/$defs/value" }, "parameters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }, "createdAt": { "type": "string", "format": "date-time" } },
      "additionalProperties": false
    }
  }
}
